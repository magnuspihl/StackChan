+void NeonLight::setEffect(LightEffect effect, const uitk::color::Rgb_t& rgb, uint32_t periodMs)
+{
+    if (effect == LightEffect::Solid) {
+        setColor(rgb);
+        return;
+    }
+    _effect           = effect;
+    _effect_color     = rgb;
+    _effect_period_ms = std::clamp<uint32_t>(periodMs, 100, 20000);
+    _effect_start_ms  = GetHAL().millis();
+    _dirty            = true;
+}
+
+void NeonLight::setPixel(int index, const uitk::color::Rgb_t& rgb)
+{
+    if (index < 0 || index >= _led_count) {
+        return;
+    }
+    if (_effect != LightEffect::Custom) {
+        // Start from what is showing now, so the other LEDs don't jump.
+        const uint32_t now = GetHAL().millis();
+        for (int i = 0; i < _led_count; i++) {
+            _pixels[i] = effect_pixel(i, now);
+        }
+        _effect = LightEffect::Custom;
+    }
+    _pixels[index] = rgb;
+    _dirty         = true;
+}
+
+void NeonLight::off()
+{
+    _effect = LightEffect::Solid;
+    _color_anim.teleport(0, 0, 0);
+    _color_anim.update();
+    _dirty = true;
+}
