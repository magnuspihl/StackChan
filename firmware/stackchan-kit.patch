diff --git a/firmware/main/hal/kit_serial_config.cpp b/firmware/main/hal/kit_serial_config.cpp
new file mode 100644
index 0000000..8f85df7
--- /dev/null
+++ b/firmware/main/hal/kit_serial_config.cpp
@@ -0,0 +1,248 @@
+/*
+ * Kit: settings over USB, for the web flasher.
+ *
+ * The flasher page writes one command per line on the USB serial port:
+ *   KIT {"cmd":"info"}
+ *   KIT {"cmd":"set","values":{"llm_key":"...","llm_model":"..."}}   ("" resets a key to its default)
+ *   KIT {"cmd":"wifi","ssid":"...","password":"..."}
+ *   KIT {"cmd":"boot_ai","on":true}   (start straight in the AI Agent)
+ *   KIT {"cmd":"reboot"}
+ * and the robot answers with one line: KIT-REPLY {"ok":true,...} or KIT-REPLY {"ok":false,"error":"..."}.
+ * Secrets are never sent back; "info" only says whether a key is set.
+ * Nothing is reachable over the network: this only exists on the USB cable.
+ */
+#include "kit_serial_config.h"
+
+#include <cJSON.h>
+#include <driver/usb_serial_jtag.h>
+#include <esp_app_desc.h>
+#include <esp_log.h>
+#include <esp_system.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+#include <ssid_manager.h>
+
+#include <cstring>
+#include <string>
+
+#include "hal.h"
+#include "settings.h"
+#include "system_info.h"
+
+#if CONFIG_KIT_LOCAL_AGENT
+
+namespace {
+
+constexpr const char* kTag       = "KitSerial";
+constexpr size_t kMaxLineLength  = 8192;  // a custom prompt fits comfortably
+constexpr const char* kPrefix    = "KIT ";
+
+struct KitKey {
+    const char* name;
+    bool secret;
+};
+// The NVS keys LocalAgentProtocol::LoadSettings reads (namespace "kit").
+constexpr KitKey kKeys[] = {
+    {"llm_url", false},   {"llm_key", true},    {"llm_model", false}, {"tts_url", false},
+    {"tts_key", true},    {"tts_model", false}, {"tts_voice", false}, {"stt_url", false},
+    {"stt_key", true},    {"stt_model", false}, {"stt_lang", false},  {"reply_lang", false},
+    {"persona", false},   {"prompt", false},    {"sleep_min", false},
+};
+
+const KitKey* FindKey(const char* name)
+{
+    for (const auto& key : kKeys) {
+        if (strcmp(key.name, name) == 0) {
+            return &key;
+        }
+    }
+    return nullptr;
+}
+
+void Reply(cJSON* reply)
+{
+    char* printed    = cJSON_PrintUnformatted(reply);
+    std::string line = std::string("\nKIT-REPLY ") + (printed ? printed : "{}") + "\n";
+    cJSON_free(printed);
+    cJSON_Delete(reply);
+    usb_serial_jtag_write_bytes(line.data(), line.size(), pdMS_TO_TICKS(1000));
+}
+
+void ReplyError(const std::string& error)
+{
+    cJSON* reply = cJSON_CreateObject();
+    cJSON_AddBoolToObject(reply, "ok", false);
+    cJSON_AddStringToObject(reply, "error", error.c_str());
+    Reply(reply);
+}
+
+void HandleInfo()
+{
+    cJSON* reply = cJSON_CreateObject();
+    cJSON_AddBoolToObject(reply, "ok", true);
+    cJSON_AddStringToObject(reply, "firmware", esp_app_get_description()->version);
+    cJSON_AddStringToObject(reply, "mac", SystemInfo::GetMacAddress().c_str());
+
+    // Only what is stored on the robot; empty means the build default applies.
+    Settings nvs("kit", false);
+    cJSON* settings = cJSON_AddObjectToObject(reply, "settings");
+    for (const auto& key : kKeys) {
+        const std::string value = nvs.GetString(key.name, "");
+        if (key.secret) {
+            cJSON_AddBoolToObject(settings, key.name, !value.empty());
+        } else {
+            cJSON_AddStringToObject(settings, key.name, value.c_str());
+        }
+    }
+
+    cJSON_AddBoolToObject(reply, "boot_ai", GetHAL().getXiaozhiConfig().startAiAgentOnBoot);
+
+    cJSON* wifi = cJSON_AddArrayToObject(reply, "wifi");
+    for (const auto& item : SsidManager::GetInstance().GetSsidList()) {
+        cJSON_AddItemToArray(wifi, cJSON_CreateString(item.ssid.c_str()));
+    }
+    Reply(reply);
+}
+
+void HandleSet(cJSON* values)
+{
+    if (!cJSON_IsObject(values)) {
+        ReplyError("set needs a \"values\" object");
+        return;
+    }
+    // Validate everything before writing anything.
+    cJSON* item = nullptr;
+    cJSON_ArrayForEach(item, values)
+    {
+        if (!FindKey(item->string)) {
+            ReplyError(std::string("unknown setting: ") + item->string);
+            return;
+        }
+        if (!cJSON_IsString(item)) {
+            ReplyError(std::string("not a string: ") + item->string);
+            return;
+        }
+    }
+    Settings nvs("kit", true);
+    int changed = 0;
+    cJSON_ArrayForEach(item, values)
+    {
+        if (item->valuestring[0] == '\0') {
+            nvs.EraseKey(item->string);
+        } else {
+            nvs.SetString(item->string, item->valuestring);
+        }
+        changed++;
+    }
+    ESP_LOGI(kTag, "Saved %d setting(s)", changed);
+    cJSON* reply = cJSON_CreateObject();
+    cJSON_AddBoolToObject(reply, "ok", true);
+    cJSON_AddNumberToObject(reply, "changed", changed);
+    Reply(reply);
+}
+
+void HandleWifi(cJSON* root)
+{
+    cJSON* ssid     = cJSON_GetObjectItem(root, "ssid");
+    cJSON* password = cJSON_GetObjectItem(root, "password");
+    if (!cJSON_IsString(ssid) || ssid->valuestring[0] == '\0' || strlen(ssid->valuestring) > 32) {
+        ReplyError("wifi needs an ssid (1-32 characters)");
+        return;
+    }
+    const std::string pass = cJSON_IsString(password) ? password->valuestring : "";
+    if (!pass.empty() && (pass.size() < 8 || pass.size() > 64)) {
+        ReplyError("a Wi-Fi password is 8-64 characters");
+        return;
+    }
+    // The same store the StackChan app's Bluetooth setup writes to.
+    SsidManager::GetInstance().AddSsid(ssid->valuestring, pass);
+    ESP_LOGI(kTag, "Saved Wi-Fi network %s", ssid->valuestring);
+    cJSON* reply = cJSON_CreateObject();
+    cJSON_AddBoolToObject(reply, "ok", true);
+    Reply(reply);
+}
+
+void HandleLine(const std::string& line)
+{
+    if (line.rfind(kPrefix, 0) != 0) {
+        return;  // not for us
+    }
+    cJSON* root = cJSON_Parse(line.c_str() + strlen(kPrefix));
+    cJSON* cmd  = cJSON_GetObjectItem(root, "cmd");
+    if (!cJSON_IsString(cmd)) {
+        ReplyError("expected KIT {\"cmd\":...}");
+    } else if (strcmp(cmd->valuestring, "info") == 0) {
+        HandleInfo();
+    } else if (strcmp(cmd->valuestring, "set") == 0) {
+        HandleSet(cJSON_GetObjectItem(root, "values"));
+    } else if (strcmp(cmd->valuestring, "boot_ai") == 0) {
+        // M5's "start AI agent on boot" switch (the Setup app has the same one).
+        cJSON* on = cJSON_GetObjectItem(root, "on");
+        if (!cJSON_IsBool(on)) {
+            ReplyError("boot_ai needs \"on\": true or false");
+        } else {
+            auto config               = GetHAL().getXiaozhiConfig();
+            config.startAiAgentOnBoot = cJSON_IsTrue(on);
+            GetHAL().setXiaozhiConfig(config);
+            cJSON* reply = cJSON_CreateObject();
+            cJSON_AddBoolToObject(reply, "ok", true);
+            Reply(reply);
+        }
+    } else if (strcmp(cmd->valuestring, "wifi") == 0) {
+        HandleWifi(root);
+    } else if (strcmp(cmd->valuestring, "reboot") == 0) {
+        cJSON* reply = cJSON_CreateObject();
+        cJSON_AddBoolToObject(reply, "ok", true);
+        Reply(reply);
+        vTaskDelay(pdMS_TO_TICKS(300));
+        esp_restart();
+    } else {
+        ReplyError(std::string("unknown command: ") + cmd->valuestring);
+    }
+    cJSON_Delete(root);
+}
+
+void SerialTask(void*)
+{
+    std::string line;
+    uint8_t buffer[128];
+    while (true) {
+        const int n = usb_serial_jtag_read_bytes(buffer, sizeof(buffer), portMAX_DELAY);
+        for (int i = 0; i < n; i++) {
+            const char c = static_cast<char>(buffer[i]);
+            if (c == '\n' || c == '\r') {
+                if (!line.empty()) {
+                    HandleLine(line);
+                }
+                line.clear();
+            } else if (line.size() < kMaxLineLength) {
+                line += c;
+            }
+        }
+    }
+}
+
+}  // namespace
+
+void kit::StartSerialConfig()
+{
+    if (!usb_serial_jtag_is_driver_installed()) {
+        usb_serial_jtag_driver_config_t config = USB_SERIAL_JTAG_DRIVER_CONFIG_DEFAULT();
+        config.rx_buffer_size                  = 1024;
+        config.tx_buffer_size                  = 1024;
+        if (usb_serial_jtag_driver_install(&config) != ESP_OK) {
+            ESP_LOGE(kTag, "Cannot install the USB serial driver; settings over USB are off");
+            return;
+        }
+    }
+    xTaskCreate(SerialTask, "kit_serial", 6 * 1024, nullptr, 2, nullptr);
+    ESP_LOGI(kTag, "Listening for settings on USB");
+}
+
+#else
+
+void kit::StartSerialConfig()
+{
+}
+
+#endif
