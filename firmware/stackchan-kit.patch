+bool StackChanCamera::GetJpeg(std::string& jpeg)
+{
+    // Kit: encode synchronously into one buffer (PSRAM) for the on-device agent.
+    jpeg.clear();
+    if (frame_.data == nullptr) {
+        return false;
+    }
+    uint16_t w = frame_.width ? frame_.width : 320;
+    uint16_t h = frame_.height ? frame_.height : 240;
+    bool ok    = image_to_jpeg_cb(
+        frame_.data, frame_.len, w, h, frame_.format, 80,
+        [](void* arg, size_t index, const void* data, size_t len) -> size_t {
+            if (index == 0 && data != nullptr && len > 0) {
+                static_cast<std::string*>(arg)->append(static_cast<const char*>(data), len);
+            }
+            return len;
+        },
+        &jpeg);
+    return ok && !jpeg.empty();
+}
