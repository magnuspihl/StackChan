diff --git a/firmware/main/stackchan/modifiers/head_loop.h b/firmware/main/stackchan/modifiers/head_loop.h
new file mode 100644
index 0000000..ed78a14
--- /dev/null
+++ b/firmware/main/stackchan/modifiers/head_loop.h
@@ -0,0 +1,75 @@
+/*
+ * Kit: head dances and gestures (sway, nod, ...), looping for a set time.
+ *
+ * Each pattern is a few far-apart points; every point is sent to the servos
+ * once and their spring animation swings the head there (the way the idle
+ * motion moves). Re-targeting more often would make it worse: every new
+ * target restarts the spring from standstill (Servo::update_angle_anim_target).
+ * Only the servos move: the face and the LEDs stay with their own tools.
+ */
+#pragma once
+#include "../modifiable.h"
+#include <hal/hal.h>
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+namespace stackchan {
+
+struct HeadStep {
+    int yaw;      // degrees from the centre, negative = the robot's left
+    int pitch;    // degrees from the centre, positive = up
+    int hold_ms;  // until the next point
+};
+
+class HeadLoopModifier : public Modifier {
+public:
+    // steps loop until duration_ms is up; tempo 2 = twice as fast; speed 100-1000 (servo spring).
+    HeadLoopModifier(std::vector<HeadStep> steps, int duration_ms, float tempo, int speed)
+        : _steps(std::move(steps)), _duration_ms(duration_ms), _tempo(std::max(tempo, 0.2f)), _speed(speed)
+    {
+    }
+
+    void _update(Modifiable& stackchan) override
+    {
+        auto& motion       = stackchan.motion();
+        const uint32_t now = GetHAL().millis();
+        if (!_started) {
+            _home_yaw   = motion.yawServo().getCurrentAngle();
+            _home_pitch = motion.pitchServo().getCurrentAngle();
+            _end_ms     = now + _duration_ms;
+            _started    = true;
+        }
+        if (now < _next_ms) {
+            return;
+        }
+        if (now >= _end_ms || _steps.empty()) {
+            motion.yawServo().moveWithSpeed(_home_yaw, 500);
+            motion.pitchServo().moveWithSpeed(_home_pitch, 500);
+            requestDestroy();
+            return;
+        }
+        // Dance around where the head was looking, kept clear of the limits.
+        const int centre_yaw   = std::clamp(_home_yaw / 10, -60, 60);
+        const int centre_pitch = std::clamp(_home_pitch / 10, 25, 55);
+        const HeadStep& step   = _steps[_index];
+        _index                 = (_index + 1) % _steps.size();
+        motion.yawServo().moveWithSpeed(std::clamp(centre_yaw + step.yaw, -128, 128) * 10, _speed);
+        motion.pitchServo().moveWithSpeed(std::clamp(centre_pitch + step.pitch, 0, 90) * 10, _speed);
+        _next_ms = now + static_cast<uint32_t>(std::max(step.hold_ms, 100) / _tempo);
+    }
+
+private:
+    std::vector<HeadStep> _steps;
+    int _duration_ms;
+    float _tempo;
+    int _speed;
+    bool _started     = false;
+    int _home_yaw     = 0;
+    int _home_pitch   = 0;
+    size_t _index     = 0;
+    uint32_t _end_ms  = 0;
+    uint32_t _next_ms = 0;
+};
+
+}  // namespace stackchan
