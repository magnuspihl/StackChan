+void StackChanAvatarDisplay::SetStatusDot(bool visible, uint32_t color, bool breathe)
+{
+    // Caller holds the display lock. The dot lives on the avatar's screen, which
+    // other apps replace, so re-create it if LVGL has deleted it.
+    if (status_dot_ == nullptr || !lv_obj_is_valid(status_dot_)) {
+        status_dot_ = lv_obj_create(lv_screen_active());
+        lv_obj_remove_style_all(status_dot_);
+        lv_obj_set_size(status_dot_, 14, 14);
+        lv_obj_set_style_radius(status_dot_, LV_RADIUS_CIRCLE, 0);
+        lv_obj_set_style_bg_opa(status_dot_, LV_OPA_COVER, 0);
+        lv_obj_align(status_dot_, LV_ALIGN_TOP_RIGHT, -12, 12);
+        lv_obj_remove_flag(status_dot_, LV_OBJ_FLAG_CLICKABLE);
+    }
+    lv_anim_delete(status_dot_, nullptr);
+    lv_obj_set_style_opa(status_dot_, LV_OPA_COVER, 0);
+    if (!visible) {
+        lv_obj_add_flag(status_dot_, LV_OBJ_FLAG_HIDDEN);
+        return;
+    }
+    lv_obj_remove_flag(status_dot_, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_set_style_bg_color(status_dot_, lv_color_hex(color), 0);
+    lv_obj_move_foreground(status_dot_);
+    if (breathe) {
+        lv_anim_t a;
+        lv_anim_init(&a);
+        lv_anim_set_var(&a, status_dot_);
+        lv_anim_set_values(&a, LV_OPA_20, LV_OPA_COVER);
+        lv_anim_set_duration(&a, 800);
+        lv_anim_set_reverse_duration(&a, 800);
+        lv_anim_set_repeat_count(&a, LV_ANIM_REPEAT_INFINITE);
+        lv_anim_set_path_cb(&a, lv_anim_path_ease_in_out);
+        lv_anim_set_exec_cb(&a, [](void* obj, int32_t v) {
+            lv_obj_set_style_opa(static_cast<lv_obj_t*>(obj), static_cast<lv_opa_t>(v), 0);
+        });
+        lv_anim_start(&a);
+    }
+}
+
+void StackChanAvatarDisplay::ArmSleepTimer(bool arm)
+{
+    if (sleep_timer_ == nullptr) {
+        esp_timer_create_args_t args = {};
+        args.callback                = [](void* arg) {
+            auto* self = static_cast<StackChanAvatarDisplay*>(arg);
+            // Same as "go to sleep", on the main task; only if still waiting and awake.
+            Application::GetInstance().Schedule([self]() {
+                if (_is_xiaozhi_idle && !self->is_sleeping_) {
+                    ESP_LOGI(TAG, "No conversation for a while: going to sleep");
+                    self->SetEmotion("sleepy");
+                }
+            });
+        };
+        args.arg  = this;
+        args.name = "kit_sleep";
+        if (esp_timer_create(&args, &sleep_timer_) != ESP_OK) {
+            sleep_timer_ = nullptr;
+            return;
+        }
+    }
+    esp_timer_stop(sleep_timer_);
+    if (!arm) {
+        return;
+    }
+    Settings settings("kit", false);
+    const int minutes = atoi(settings.GetString("sleep_min", "10").c_str());
+    if (minutes > 0) {
+        esp_timer_start_once(sleep_timer_, static_cast<uint64_t>(minutes) * 60 * 1000 * 1000);
     }
 }
 
