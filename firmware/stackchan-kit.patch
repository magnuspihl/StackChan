+uitk::color::Rgb_t scaled(const uitk::color::Rgb_t& c, float level)
+{
+    return uitk::color::Rgb_t(c.r * level, c.g * level, c.b * level);
+}
+
+// 0..1..0 over one period, starting dark.
+float wave(uint32_t elapsed, uint32_t period)
+{
+    const float phase = static_cast<float>(elapsed % period) / period;
+    return (1.0f - std::cos(phase * 2.0f * static_cast<float>(M_PI))) / 2.0f;
+}
+
+uitk::color::Rgb_t hue_to_rgb(float hue, uint8_t value)
+{
+    const float h = std::fmod(hue, 1.0f) * 6.0f;
+    const float x = 1.0f - std::fabs(std::fmod(h, 2.0f) - 1.0f);
+    float r = 0, g = 0, b = 0;
+    switch (static_cast<int>(h)) {
+        case 0: r = 1, g = x; break;
+        case 1: r = x, g = 1; break;
+        case 2: g = 1, b = x; break;
+        case 3: g = x, b = 1; break;
+        case 4: r = x, b = 1; break;
+        default: r = 1, b = x; break;
+    }
+    return uitk::color::Rgb_t(r * value, g * value, b * value);
+}
+
+}  // namespace
