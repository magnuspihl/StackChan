+uitk::color::Rgb_t NeonLight::effect_pixel(int index, uint32_t now)
+{
+    const uint32_t elapsed = now - _effect_start_ms;
+    switch (_effect) {
+        case LightEffect::Solid:
+            return uitk::color::Rgb_t(_color_anim.r, _color_anim.g, _color_anim.b);
+        case LightEffect::Breathe:
+            return scaled(_effect_color, 0.05f + 0.95f * wave(elapsed, _effect_period_ms));
+        case LightEffect::Blink:
+            return (elapsed % _effect_period_ms) < _effect_period_ms / 2 ? _effect_color : uitk::color::Rgb_t();
+        case LightEffect::Chase: {
+            // One bright LED runs along the strip with a short fading tail.
+            const int head = (elapsed % _effect_period_ms) * _led_count / _effect_period_ms;
+            const int behind = (head - index + _led_count) % _led_count;
+            const float level = behind == 0 ? 1.0f : behind == 1 ? 0.3f : behind == 2 ? 0.08f : 0.0f;
+            return scaled(_effect_color, level);
+        }
+        case LightEffect::Rainbow: {
+            const float hue = static_cast<float>(elapsed % _effect_period_ms) / _effect_period_ms +
+                              static_cast<float>(index) / _led_count;
+            return hue_to_rgb(hue, 120);
