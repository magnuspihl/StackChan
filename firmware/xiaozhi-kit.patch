+// ---- Minimal Ogg Opus muxer (RFC 7845): one Opus packet per Ogg page. ----
+
+uint32_t OggCrc(const uint8_t* data, size_t len) {
+    static uint32_t table[256];
+    static bool ready = false;
+    if (!ready) {
+        for (uint32_t i = 0; i < 256; i++) {
+            uint32_t r = i << 24;
+            for (int j = 0; j < 8; j++) {
+                r = (r & 0x80000000u) ? (r << 1) ^ 0x04C11DB7u : (r << 1);
+            }
+            table[i] = r;
+        }
+        ready = true;
+    }
+    uint32_t crc = 0;
+    for (size_t i = 0; i < len; i++) {
+        crc = (crc << 8) ^ table[((crc >> 24) & 0xFF) ^ data[i]];
+    }
+    return crc;
+}
+
+void AppendPage(std::string& out, const uint8_t* body, size_t len, uint8_t flags, uint64_t granule,
+                uint32_t serial, uint32_t seq) {
+    std::vector<uint8_t> page;
+    page.reserve(27 + 255 + len);
+    const uint8_t header[] = {'O', 'g', 'g', 'S', 0, flags};
+    page.insert(page.end(), header, header + sizeof(header));
+    for (int i = 0; i < 8; i++) page.push_back((granule >> (8 * i)) & 0xFF);
+    for (int i = 0; i < 4; i++) page.push_back((serial >> (8 * i)) & 0xFF);
+    for (int i = 0; i < 4; i++) page.push_back((seq >> (8 * i)) & 0xFF);
+    for (int i = 0; i < 4; i++) page.push_back(0);  // CRC placeholder
+    // Lacing: runs of 255, then the remainder (a final 0 if len % 255 == 0).
+    std::vector<uint8_t> lacing(len / 255, 255);
+    lacing.push_back(len % 255);
+    page.push_back(static_cast<uint8_t>(lacing.size()));
+    page.insert(page.end(), lacing.begin(), lacing.end());
+    page.insert(page.end(), body, body + len);
+    uint32_t crc = OggCrc(page.data(), page.size());
+    for (int i = 0; i < 4; i++) page[22 + i] = (crc >> (8 * i)) & 0xFF;
+    out.append(reinterpret_cast<const char*>(page.data()), page.size());
+}
+
+std::string BuildOggOpus(const std::vector<std::vector<uint8_t>>& packets) {
+    std::string out;
+    const uint32_t serial = 0x4B495421;  // "KIT!"
+    uint32_t seq = 0;
+
+    uint8_t head[19] = {'O', 'p', 'u', 's', 'H', 'e', 'a', 'd', 1, 1};
+    const uint16_t pre_skip = 312;
+    head[10] = pre_skip & 0xFF;
+    head[11] = pre_skip >> 8;
+    for (int i = 0; i < 4; i++) head[12 + i] = (kInputSampleRate >> (8 * i)) & 0xFF;
+    // bytes 16-17 output gain = 0, byte 18 channel mapping family = 0
+    AppendPage(out, head, sizeof(head), 0x02 /* BOS */, 0, serial, seq++);
+
+    const char tags[] = "OpusTags\x09\x00\x00\x00stackchan\x00\x00\x00\x00";
+    AppendPage(out, reinterpret_cast<const uint8_t*>(tags), sizeof(tags) - 1, 0, 0, serial, seq++);
+
+    uint64_t granule = 0;
+    for (size_t i = 0; i < packets.size(); i++) {
+        granule += kOpusGranulePerFrame;
+        uint8_t flags = (i + 1 == packets.size()) ? 0x04 /* EOS */ : 0;
+        AppendPage(out, packets[i].data(), packets[i].size(), flags, granule, serial, seq++);
+    }
+    return out;
+}
+
+std::string JsonEscape(const std::string& s) {
+    cJSON* str = cJSON_CreateString(s.c_str());
+    char* printed = cJSON_PrintUnformatted(str);
+    std::string result = printed ? printed : "\"\"";
+    cJSON_free(printed);
+    cJSON_Delete(str);
+    return result;
+}
+
+std::string Trim(const std::string& s) {
+    const auto first = s.find_first_not_of(" \t\r\n");
+    const auto last = s.find_last_not_of(" \t\r\n");
+    return first == std::string::npos ? "" : s.substr(first, last - first + 1);
+}
+
+std::string JoinUrl(const std::string& base, const char* path) {
+    std::string url = base;
+    while (!url.empty() && url.back() == '/') url.pop_back();
+    return url + path;
+}
+
+// Drops emoji, pictographs and markdown emphasis, which the voice would read out.
+std::string SpeakableText(const std::string& s) {
+    std::string out;
+    for (size_t i = 0; i < s.size();) {
+        const uint8_t c = s[i];
+        const size_t len = c < 0x80 ? 1 : (c >> 5) == 0x6 ? 2 : (c >> 4) == 0xE ? 3 : (c >> 3) == 0x1E ? 4 : 1;
+        uint32_t cp = len == 1 ? c : c & (0xFF >> (len + 1));
+        for (size_t j = 1; j < len && i + j < s.size(); j++) cp = (cp << 6) | (s[i + j] & 0x3F);
+        const bool drop = (cp >= 0x1F000 && cp <= 0x1FAFF) || (cp >= 0x2600 && cp <= 0x27BF) ||
+                          cp == 0xFE0F || cp == 0x200D || cp == '*' || cp == '_' || cp == '#';
+        if (!drop) out.append(s, i, len);
+        i += len;
+    }
+    return Trim(out);
+}
+
+// cJSON makes thousands of small allocations for each model request (tool
+// definitions, history, the reply). The default allocator keeps anything under
+// 512 bytes in internal RAM, which TLS and Wi-Fi need; put cJSON in PSRAM.
+void* PsramMalloc(size_t size) {
+    void* p = heap_caps_malloc(size, MALLOC_CAP_SPIRAM);
+    return p ? p : malloc(size);
+}
+
+}  // namespace
+
+LocalAgentProtocol::LocalAgentProtocol() {
+    // Process-wide, and safe to switch at any time: free() handles both heaps.
+    cJSON_Hooks hooks = {PsramMalloc, free};
+    cJSON_InitHooks(&hooks);
+    LoadSettings();
+    jobs_ = xQueueCreate(4, sizeof(std::function<void()>*));
+    // TLS and JSON need a roomy stack; keep it in PSRAM to spare internal RAM.
+    xTaskCreatePinnedToCoreWithCaps(WorkerTask, "local_agent", 16 * 1024, this, 3, &worker_, 1,
+                                    MALLOC_CAP_SPIRAM);
+}
+
+LocalAgentProtocol::~LocalAgentProtocol() {
+    if (worker_) vTaskDelete(worker_);
+    if (jobs_) vQueueDelete(jobs_);
+}
