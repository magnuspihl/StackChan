+
+bool LocalAgentProtocol::SendText(const std::string& text) {
+    cJSON* root = cJSON_Parse(text.c_str());
+    if (!root) return false;
+    auto type = cJSON_GetObjectItem(root, "type");
+    if (cJSON_IsString(type)) {
+        if (strcmp(type->valuestring, "listen") == 0) {
+            auto state = cJSON_GetObjectItem(root, "state");
+            if (cJSON_IsString(state)) HandleListen(state->valuestring);
+        } else if (strcmp(type->valuestring, "abort") == 0) {
+            aborted_ = true;
+            std::lock_guard<std::mutex> lock(mutex_);
+            packets_.clear();
+        } else if (strcmp(type->valuestring, "mcp") == 0) {
+            // A reply from the robot's own MCP server to one of our requests.
+            auto payload = cJSON_GetObjectItem(root, "payload");
+            auto id = cJSON_GetObjectItem(payload, "id");
+            if (cJSON_IsNumber(id)) {
+                cJSON* result = cJSON_GetObjectItem(payload, "result");
+                cJSON* answer = result ? result : payload;  // errors: keep the whole object
+                char* printed = cJSON_PrintUnformatted(answer);
+                {
+                    std::lock_guard<std::mutex> lock(mcp_mutex_);
+                    mcp_replies_[id->valueint] = printed ? printed : "";
+                }
+                cJSON_free(printed);
+                mcp_cv_.notify_all();
+            }
+        }
+    }
+    cJSON_Delete(root);
+    return true;
+}
+
+void LocalAgentProtocol::HandleListen(const std::string& state) {
+    if (state == "start") {
+        aborted_ = false;
+        if (sleep_pending_.exchange(false)) {
+            // The goodbye has finished playing: sleep face, end the session.
+            ESP_LOGI(TAG, "Going to sleep");
+            EmitJson("{\"type\":\"llm\",\"emotion\":\"sleepy\"}");
+            CloseAudioChannel();
+            return;
+        }
+        ResumeListening();
+    } else if (state == "stop") {
+        std::lock_guard<std::mutex> lock(mutex_);
+        listening_ = false;
+    }
+}
+
+void LocalAgentProtocol::ResumeListening() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!channel_open_) return;
+    listening_ = true;
+    heard_voice_ = false;
+    voice_active_ = false;
+    packets_.clear();
+    listen_started_us_ = esp_timer_get_time();
+}
+
+void LocalAgentProtocol::OnVoiceActivity(bool speaking) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!listening_) return;
+    voice_active_ = speaking;
+    const int64_t now = esp_timer_get_time();
+    if (speaking) {
+        if (!heard_voice_) listen_started_us_ = now;  // the utterance clock starts at the first voice
+        heard_voice_ = true;
+    } else {
+        voice_ended_us_ = now;
+    }
+}
+
+bool LocalAgentProtocol::SendAudio(std::unique_ptr<AudioStreamPacket> packet) {
+    bool finish = false;
+    bool close = false;
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (!listening_) return true;
+        packets_.push_back(std::move(packet->payload));
+        const int64_t now = esp_timer_get_time();
+        if (!heard_voice_) {
+            // Before anyone speaks, keep only a short pre-roll.
+            if (packets_.size() > kPrerollPackets) packets_.erase(packets_.begin());
+            if (now - listen_started_us_ > kSessionIdleUs) {
+                listening_ = false;
+                close = true;
+            }
+        } else if (!voice_active_ && now - voice_ended_us_ > kEndOfSpeechSilenceUs) {
+            finish = true;
+        } else if (now - listen_started_us_ > kMaxUtteranceUs) {
+            finish = true;
+        }
+    }
+    if (finish) FinishUtterance();
+    if (close) {
+        ESP_LOGI(TAG, "No speech for %d s, ending the session", (int)(kSessionIdleUs / 1000000));
+        RunOnWorker([this]() { CloseAudioChannel(); });
+    }
+    return true;
+}
+
+void LocalAgentProtocol::FinishUtterance() {
+    std::vector<std::vector<uint8_t>> packets;
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        packets.swap(packets_);
+        heard_voice_ = false;
+        listening_ = false;  // paused until this turn is handled
+    }
+    ESP_LOGI(TAG, "Utterance done: %u packets (%.1f s)", (unsigned)packets.size(),
+             packets.size() * kInputFrameMs / 1000.0f);
+    // The mic is no longer live: show that at once, before the first request.
+    if (packets.size() >= kMinUtterancePackets) ShowStatus(KIT_STATUS_THINKING);
+    RunOnWorker([this, packets = std::move(packets)]() mutable { ProcessUtterance(std::move(packets)); });
+}
+
+void LocalAgentProtocol::ProcessUtterance(std::vector<std::vector<uint8_t>> packets) {
+    if (packets.size() < kMinUtterancePackets) {
+        ResumeListening();
+        return;
+    }
+    int64_t t0 = esp_timer_get_time();
+    std::string text = Transcribe(BuildOggOpus(packets));
+    ESP_LOGI(TAG, "STT %d ms: \"%s\"", (int)((esp_timer_get_time() - t0) / 1000), text.c_str());
+    std::string lower;
+    for (char c : text) {
+        if (c != '.' && c != ',' && c != '!') lower += static_cast<char>(tolower(static_cast<unsigned char>(c)));
+    }
+    bool phantom = false;
+    for (const char* p : kPhantomTranscripts) phantom = phantom || lower == p;
+    for (const char* p : kPhantomPrefixes) phantom = phantom || lower.rfind(p, 0) == 0;
+    if (text.empty() || phantom || aborted_) {
+        if (!aborted_) ShowStatus(Lang::Strings::LISTENING);  // nothing to answer: the mic is live again
+        ResumeListening();
+        return;
+    }
+    EmitJson("{\"type\":\"stt\",\"text\":" + JsonEscape(text) + "}");
+    // Show that it heard and is working on it; the LLM can take a while.
+    EmitJson("{\"type\":\"llm\",\"emotion\":\"thinking\"}");
+
+    t0 = esp_timer_get_time();
+    std::string reply = Chat(text);
+    ESP_LOGI(TAG, "LLM %d ms: \"%s\" (free internal %u, psram %u)", (int)((esp_timer_get_time() - t0) / 1000),
+             reply.c_str(), (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL),
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_SPIRAM));
+    if (aborted_) {
+        ResumeListening();
+        return;
+    }
+
+    const char* emotion = reply.empty() ? "sad" : "happy";
+    for (const auto& e : kEmojiEmotions) {
+        if (reply.compare(0, strlen(e.utf8), e.utf8) == 0) {
+            emotion = e.emotion;
+            break;
+        }
+    }
+    const std::string spoken = reply.empty() ? Lines(danish_lines_).no_brain : SpeakableText(reply);
+
+    // Switch to speaking only when there is sound: a slow voice server (or one
+    // loading its model) keeps the thinking status up instead of a silent "speaking".
+    bool announced = false;
+    auto announce = [&]() {
+        if (announced) return;
+        announced = true;
+        EmitJson("{\"type\":\"tts\",\"state\":\"start\"}");
+        EmitJson(std::string("{\"type\":\"llm\",\"emotion\":\"") + emotion + "\"}");
+        EmitJson("{\"type\":\"tts\",\"state\":\"sentence_start\",\"text\":" + JsonEscape(spoken) + "}");
+    };
+    Speak(spoken, announce);
+    announce();  // no audio came: still show the reply
+    // The app goes back to listening (and sends "listen start") once playback drains.
+    EmitJson("{\"type\":\"tts\",\"state\":\"stop\"}");
+}
+
+std::string LocalAgentProtocol::Transcribe(const std::string& ogg) {
+    const std::string boundary = "----stackchankit7MA4YWxk";
+    std::string body;
+    auto field = [&](const char* name, const std::string& value) {
+        if (value.empty()) return;
+        body += "--" + boundary + "\r\nContent-Disposition: form-data; name=\"" + name + "\"\r\n\r\n" + value + "\r\n";
+    };
+    field("model", settings_.stt.model);
+    field("language", settings_.stt_language);
+    field("response_format", "json");
+    body += "--" + boundary +
+            "\r\nContent-Disposition: form-data; name=\"file\"; filename=\"speech.ogg\"\r\n"
+            "Content-Type: audio/ogg\r\n\r\n";
+    body += ogg;
+    body += "\r\n--" + boundary + "--\r\n";
+
+    const std::string url = JoinUrl(settings_.stt.base_url, "/audio/transcriptions");
+    auto http = Board::GetInstance().GetNetwork()->CreateHttp(0);
+    // esp-ml307 frees badly if the server hangs up first (its receive task
+    // calls back into the freed client), so keep the connection open and
+    // always close it from our side.
+    http->SetKeepAlive(true);
+    http->SetTimeout(30000);
+    http->SetHeader("Content-Type", "multipart/form-data; boundary=" + boundary);
+    if (!settings_.stt.key.empty()) http->SetHeader("Authorization", "Bearer " + settings_.stt.key);
+    http->SetContent(std::move(body));
+    if (!http->Open("POST", url)) {
+        ESP_LOGE(TAG, "STT: cannot connect to %s", url.c_str());
+        return "";
+    }
+    const int status = http->GetStatusCode();
+    std::string response = http->ReadAll();
+    http->Close();
+    if (status != 200) {
+        ESP_LOGE(TAG, "STT HTTP %d: %.200s", status, response.c_str());
+        return "";
+    }
+    std::string text;
+    if (cJSON* root = cJSON_Parse(response.c_str())) {
+        auto t = cJSON_GetObjectItem(root, "text");
+        if (cJSON_IsString(t)) text = t->valuestring;
+        cJSON_Delete(root);
+    }
+    return Trim(text);  // Whisper likes to add whitespace
+}
+
+std::string LocalAgentProtocol::PostJson(const Endpoint& endpoint, const char* path, std::string body,
+                                         int timeout_ms) {
+    const std::string url = JoinUrl(endpoint.base_url, path);
+    auto http = Board::GetInstance().GetNetwork()->CreateHttp(0);
+    // esp-ml307 frees badly if the server hangs up first (its receive task
+    // calls back into the freed client), so keep the connection open and
+    // always close it from our side.
+    http->SetKeepAlive(true);
+    http->SetTimeout(timeout_ms);
+    http->SetHeader("Content-Type", "application/json");
+    if (!endpoint.key.empty()) http->SetHeader("Authorization", "Bearer " + endpoint.key);
+    http->SetContent(std::move(body));
+    if (!http->Open("POST", url)) {
+        ESP_LOGE(TAG, "Cannot connect to %s", url.c_str());
+        return "";
+    }
+    const int status = http->GetStatusCode();
+    std::string response = http->ReadAll();
+    http->Close();
+    if (status != 200) {
+        ESP_LOGE(TAG, "%s: HTTP %d: %.300s", path, status, response.c_str());
+        return "";
+    }
+    return response;
+}
+
+std::string LocalAgentProtocol::McpRequest(const std::string& method, const std::string& params_json,
+                                           int timeout_ms) {
+    int id;
+    {
+        std::lock_guard<std::mutex> lock(mcp_mutex_);
+        id = next_mcp_id_++;
+    }
+    EmitJson("{\"type\":\"mcp\",\"payload\":{\"jsonrpc\":\"2.0\",\"id\":" + std::to_string(id) +
+             ",\"method\":" + JsonEscape(method) + ",\"params\":" + params_json + "}}");
+    std::unique_lock<std::mutex> lock(mcp_mutex_);
+    if (!mcp_cv_.wait_for(lock, std::chrono::milliseconds(timeout_ms),
+                          [this, id]() { return mcp_replies_.count(id) > 0; })) {
+        ESP_LOGW(TAG, "MCP %s: no reply", method.c_str());
+        return "";
+    }
+    std::string reply = std::move(mcp_replies_[id]);
+    mcp_replies_.erase(id);
+    return reply;
+}
+
+void LocalAgentProtocol::LoadTools() {
+    McpRequest("initialize", "{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{}}");
+    cJSON* tools = cJSON_CreateArray();
+    tool_names_.clear();
+    std::string cursor;
+    do {
+        const std::string params = cursor.empty() ? "{}" : "{\"cursor\":" + JsonEscape(cursor) + "}";
+        cJSON* result = cJSON_Parse(McpRequest("tools/list", params).c_str());
+        cursor.clear();
+        if (!result) break;
+        cJSON* list = cJSON_GetObjectItem(result, "tools");
+        cJSON* tool = nullptr;
+        cJSON_ArrayForEach(tool, list) {
+            cJSON* name = cJSON_GetObjectItem(tool, "name");
+            if (!cJSON_IsString(name)) continue;
+            const std::string mcp_name = name->valuestring;
+            bool hidden = false;
+            for (const char* prefix : kHiddenToolPrefixes) {
+                hidden = hidden || mcp_name.rfind(prefix, 0) == 0;
+            }
+            if (hidden) continue;
+            // Function names may only use [A-Za-z0-9_-]; MCP names have dots.
+            std::string function_name = mcp_name;
+            for (char& c : function_name) {
+                if (c == '.') c = '_';
+            }
+            tool_names_[function_name] = mcp_name;
+            cJSON* function = cJSON_CreateObject();
+            cJSON_AddStringToObject(function, "name", function_name.c_str());
+            cJSON* description = cJSON_GetObjectItem(tool, "description");
+            cJSON_AddStringToObject(function, "description",
+                                    cJSON_IsString(description) ? description->valuestring : "");
+            cJSON* schema = cJSON_GetObjectItem(tool, "inputSchema");
+            cJSON_AddItemToObject(function, "parameters",
+                                  schema ? cJSON_Duplicate(schema, true) : cJSON_CreateObject());
+            cJSON* entry = cJSON_CreateObject();
+            cJSON_AddStringToObject(entry, "type", "function");
+            cJSON_AddItemToObject(entry, "function", function);
+            cJSON_AddItemToArray(tools, entry);
+        }
+        cJSON* next = cJSON_GetObjectItem(result, "nextCursor");
+        if (cJSON_IsString(next)) cursor = next->valuestring;
+        cJSON_Delete(result);
+    } while (!cursor.empty());
+
+    // The sleep tool is ours, not the device's: it ends the session after the goodbye.
+    cJSON* sleep = cJSON_Parse(
+        "{\"type\":\"function\",\"function\":{\"name\":\"go_to_sleep\",\"description\":\"Go to sleep: "
+        "says your goodbye, closes your eyes and ends the conversation. Call it when the user says goodbye, "
+        "goodnight, or tells you to sleep or stop listening.\",\"parameters\":{\"type\":\"object\","
+        "\"properties\":{\"goodbye\":{\"type\":\"string\",\"description\":\"What you say before "
+        "falling asleep: a short, warm goodbye in your own voice, starting with one face emoji. It is spoken "
+        "aloud as is.\"}},\"required\":[\"goodbye\"]}}}");
+    cJSON_AddItemToArray(tools, sleep);
+    if (Board::GetInstance().GetCamera()) {
+        cJSON_AddItemToArray(tools, cJSON_Parse(
+            "{\"type\":\"function\",\"function\":{\"name\":\"take_photo\",\"description\":\"Take a photo "
+            "with your camera, which looks where your head points. Use it whenever the user asks what you can see "
+            "or wants you to look at something; move your head first if needed. The photo is then shown to you.\","
+            "\"parameters\":{\"type\":\"object\",\"properties\":{}}}}"));
+    }
+
+    char* printed = cJSON_PrintUnformatted(tools);
+    tools_json_ = printed ? printed : "[]";
+    cJSON_free(printed);
+    ESP_LOGI(TAG, "%d tools for the model", cJSON_GetArraySize(tools));
+    cJSON_Delete(tools);
+}
+
+std::string LocalAgentProtocol::CallTool(const std::string& name, const std::string& arguments) {
+    ESP_LOGI(TAG, "Tool %s %s", name.c_str(), arguments.c_str());
+    if (name == kSleepTool) {
+        sleep_pending_ = true;
+        sleep_goodbye_.clear();
+        if (cJSON* args = cJSON_Parse(arguments.c_str())) {
+            cJSON* goodbye = cJSON_GetObjectItem(args, "goodbye");
+            if (cJSON_IsString(goodbye)) sleep_goodbye_ = Trim(goodbye->valuestring);
+            cJSON_Delete(args);
+        }
+        return "Asleep.";
+    }
+    if (name == kPhotoTool) {
+        auto camera = Board::GetInstance().GetCamera();
+        std::string jpeg;
+        if (!camera || !camera->Capture() || !camera->GetJpeg(jpeg)) return "Error: the camera failed";
+        size_t len = 0;
+        mbedtls_base64_encode(nullptr, 0, &len, reinterpret_cast<const uint8_t*>(jpeg.data()), jpeg.size());
+        std::string b64(len, '\0');
+        mbedtls_base64_encode(reinterpret_cast<uint8_t*>(b64.data()), len, &len,
+                              reinterpret_cast<const uint8_t*>(jpeg.data()), jpeg.size());
+        b64.resize(len);
+        pending_photo_ = "data:image/jpeg;base64," + b64;
+        ESP_LOGI(TAG, "Photo: %u bytes JPEG", (unsigned)jpeg.size());
+        return "Photo taken. It is attached in the next message.";
+    }
+    auto it = tool_names_.find(name);
+    if (it == tool_names_.end()) return "Error: unknown tool " + name;
+    // Models sometimes send "" for no arguments; MCP wants an object.
+    cJSON* args = cJSON_Parse(arguments.c_str());
+    if (!cJSON_IsObject(args)) {
+        cJSON_Delete(args);
+        args = cJSON_CreateObject();
+    }
+    char* printed = cJSON_PrintUnformatted(args);
+    std::string params = "{\"name\":" + JsonEscape(it->second) + ",\"arguments\":" + (printed ? printed : "{}") + "}";
+    cJSON_free(printed);
+    cJSON_Delete(args);
+    // Head moves can take a few seconds before the tool replies.
+    std::string reply = McpRequest("tools/call", params, 15000);
+    return reply.empty() ? "Error: the tool did not answer" : reply;
+}
+
+std::string LocalAgentProtocol::Chat(const std::string& user_text) {
+    const int64_t now = esp_timer_get_time();
+    if (now - last_turn_us_ > kHistoryExpiryUs) history_.clear();
+    last_turn_us_ = now;
+    if (tools_json_.empty()) LoadTools();
+    // Old photos are sent only once: tens of KB each, on every request otherwise.
+    for (auto& m : history_) {
+        if (m.find("\"image_url\"") != std::string::npos) {
+            m = std::string("{\"role\":\"user\",\"content\":") + JsonEscape(kPhotoPlaceholder) + "}";
+        }
+    }
+
+    auto message_json = [](const char* role, const std::string& content) {
+        return std::string("{\"role\":\"") + role + "\",\"content\":" + JsonEscape(content) + "}";
+    };
+    const size_t turn_start = history_.size();
+    history_.push_back(message_json("user", user_text));
+    bool used_tools = false;
+
+    for (int round = 0; round < kMaxToolRounds && !aborted_; round++) {
+        cJSON* request = cJSON_CreateObject();
+        cJSON_AddStringToObject(request, "model", settings_.llm.model.c_str());
+        cJSON_AddNumberToObject(request, "max_tokens", 400);
+        cJSON* messages = cJSON_AddArrayToObject(request, "messages");
+        cJSON_AddItemToArray(messages, cJSON_Parse(message_json("system", settings_.prompt).c_str()));
+        for (const auto& m : history_) cJSON_AddItemToArray(messages, cJSON_Parse(m.c_str()));
+        cJSON_AddItemToObject(request, "tools", cJSON_Parse(tools_json_.c_str()));
+        char* printed = cJSON_PrintUnformatted(request);
+        std::string body = printed ? printed : "";
+        cJSON_free(printed);
+        cJSON_Delete(request);
+
+        cJSON* root = cJSON_Parse(PostJson(settings_.llm, "/chat/completions", std::move(body), 60000).c_str());
+        cJSON* choices = cJSON_GetObjectItem(root, "choices");
+        cJSON* message = cJSON_GetObjectItem(cJSON_GetArrayItem(choices, 0), "message");
+        if (!cJSON_IsObject(message)) {
+            cJSON_Delete(root);
+            break;
+        }
+        cJSON* content = cJSON_GetObjectItem(message, "content");
+        std::string reply = cJSON_IsString(content) ? Trim(content->valuestring) : "";
+        cJSON* tool_calls = cJSON_GetObjectItem(message, "tool_calls");
+
+        if (cJSON_GetArraySize(tool_calls) > 0) {
+            // Keep the model's tool request in the conversation, then the results.
+            cJSON* assistant = cJSON_CreateObject();
+            cJSON_AddStringToObject(assistant, "role", "assistant");
+            cJSON_AddStringToObject(assistant, "content", reply.c_str());
+            cJSON_AddItemToObject(assistant, "tool_calls", cJSON_Duplicate(tool_calls, true));
+            char* assistant_json = cJSON_PrintUnformatted(assistant);
+            history_.push_back(assistant_json ? assistant_json : "{}");
+            cJSON_free(assistant_json);
+            cJSON_Delete(assistant);
+
+            cJSON* call = nullptr;
+            cJSON_ArrayForEach(call, tool_calls) {
+                cJSON* id = cJSON_GetObjectItem(call, "id");
+                cJSON* function = cJSON_GetObjectItem(call, "function");
+                cJSON* name = cJSON_GetObjectItem(function, "name");
+                cJSON* arguments = cJSON_GetObjectItem(function, "arguments");
+                const std::string result =
+                    CallTool(cJSON_IsString(name) ? name->valuestring : "",
+                             cJSON_IsString(arguments) ? arguments->valuestring : "{}");
+                history_.push_back("{\"role\":\"tool\",\"tool_call_id\":" +
+                                   JsonEscape(cJSON_IsString(id) ? id->valuestring : "") +
+                                   ",\"content\":" + JsonEscape(result) + "}");
+            }
+            cJSON_Delete(root);
+            used_tools = true;
+            if (!pending_photo_.empty()) {
+                // Tool results are text-only in the OpenAI format; the image follows as a user message.
+                history_.push_back(
+                    "{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"The photo you just took:\"},"
+                    "{\"type\":\"image_url\",\"image_url\":{\"url\":\"" + pending_photo_ + "\"}}]}");
+                pending_photo_.clear();
+            }
+            if (sleep_pending_) {
+                // No second model round for sleep: it only narrates the tool
+                // ("the conversation has ended..."). Say the goodbye and stop.
+                if (reply.empty()) reply = sleep_goodbye_;
+                if (reply.empty()) reply = Lines(danish_lines_).goodnight;
+                history_.push_back(message_json("assistant", reply));
+                return reply;
+            }
+            continue;
+        }
+        cJSON_Delete(root);
+
+        if (reply.empty() && used_tools) reply = Lines(danish_lines_).done;
+        if (reply.empty()) break;
+        history_.push_back(message_json("assistant", reply));
+        // Forget the oldest turns; history must start at a user message.
+        while (history_.size() > kMaxHistoryMessages ||
+               (!history_.empty() && history_.front().rfind("{\"role\":\"user\"", 0) != 0)) {
+            history_.erase(history_.begin());
+        }
+        return reply;
+    }
+    // Failed or aborted: drop the unfinished turn.
+    history_.resize(turn_start);
+    return "";
+}
+
+void LocalAgentProtocol::Speak(const std::string& text, const std::function<void()>& on_first_audio) {
+    if (text.empty() || !on_incoming_pcm_) return;
+    const int64_t t0 = esp_timer_get_time();
+
+    cJSON* request = cJSON_CreateObject();
+    cJSON_AddStringToObject(request, "model", settings_.tts.model.c_str());
+    cJSON_AddStringToObject(request, "voice", settings_.tts_voice.c_str());
+    cJSON_AddStringToObject(request, "input", text.c_str());
+    cJSON_AddStringToObject(request, "response_format", "pcm");
+    char* printed = cJSON_PrintUnformatted(request);
+    std::string body = printed ? printed : "";
+    cJSON_free(printed);
+    cJSON_Delete(request);
+
+    const std::string url = JoinUrl(settings_.tts.base_url, "/audio/speech");
+    auto http = Board::GetInstance().GetNetwork()->CreateHttp(0);
+    // esp-ml307 frees badly if the server hangs up first (its receive task
+    // calls back into the freed client), so keep the connection open and
+    // always close it from our side.
+    http->SetKeepAlive(true);
+    http->SetTimeout(120000);  // a local voice server may first have to load its model
+    http->SetHeader("Content-Type", "application/json");
+    if (!settings_.tts.key.empty()) http->SetHeader("Authorization", "Bearer " + settings_.tts.key);
+    http->SetContent(std::move(body));
+    if (!http->Open("POST", url)) {
+        ESP_LOGE(TAG, "TTS: cannot connect to %s", url.c_str());
+        return;
+    }
+    const int status = http->GetStatusCode();
+    if (status != 200) {
+        ESP_LOGE(TAG, "TTS HTTP %d: %.200s", status, http->ReadAll().c_str());
+        http->Close();
+        return;
+    }
+
+    // Chunks wait here until the pre-buffer is full (or the stream ends).
+    std::vector<std::vector<int16_t>> pending;
+    bool started = false;
+    bool playing = true;
+    auto flush = [&]() {
+        for (auto& chunk : pending) {
+            if (aborted_) {
+                playing = false;
+                break;
+            }
+            if (!started) {
+                on_first_audio();
+                // The app only takes audio once it has switched to speaking,
+                // which it does asynchronously after "tts start".
+                for (int i = 0; i < 100 && !started && !aborted_; i++) {
+                    std::vector<int16_t> copy = chunk;
+                    started = on_incoming_pcm_(std::move(copy), kTtsSampleRate);
+                    if (!started) vTaskDelay(pdMS_TO_TICKS(20));
+                }
+                if (!started) {
+                    playing = false;
+                    break;
+                }
+                ESP_LOGI(TAG, "TTS playing after %d ms", (int)((esp_timer_get_time() - t0) / 1000));
+            } else if (!on_incoming_pcm_(std::move(chunk), kTtsSampleRate)) {
+                playing = false;  // interrupted
+                break;
+            }
+        }
+        pending.clear();
+    };
+
+    std::vector<int16_t> chunk;
+    chunk.reserve(kTtsChunkSamples);
+    int odd_byte = -1;  // PCM can arrive split mid-sample
+    size_t total_bytes = 0;
+    char buffer[2048];
+    while (playing) {
+        const int n = http->Read(buffer, sizeof(buffer));
+        if (n <= 0) break;
+        total_bytes += n;
+        int i = 0;
+        if (odd_byte >= 0) {
+            chunk.push_back(static_cast<int16_t>(odd_byte | (static_cast<uint8_t>(buffer[0]) << 8)));
+            odd_byte = -1;
+            i = 1;
+        }
+        for (; i + 1 < n; i += 2) {
+            chunk.push_back(static_cast<int16_t>(static_cast<uint8_t>(buffer[i]) |
+                                                 (static_cast<uint8_t>(buffer[i + 1]) << 8)));
+            if (chunk.size() == kTtsChunkSamples) {
+                pending.push_back(std::move(chunk));
+                chunk = {};
+                chunk.reserve(kTtsChunkSamples);
+                if (started || pending.size() >= kTtsPrebufferChunks) flush();
+                if (!playing) break;
+            }
+        }
+        if (playing && i < n) odd_byte = static_cast<uint8_t>(buffer[i]);
+    }
+    if (playing && !chunk.empty()) pending.push_back(std::move(chunk));
+    if (playing) flush();
+    http->Close();
+    ESP_LOGI(TAG, "TTS %d ms, %.1f s of audio%s", (int)((esp_timer_get_time() - t0) / 1000),
+             total_bytes / 2.0f / kTtsSampleRate, playing ? "" : " (interrupted)");
+}
+
+void LocalAgentProtocol::ShowStatus(const char* status) {
+    Application::GetInstance().Schedule([status]() { Board::GetInstance().GetDisplay()->SetStatus(status); });
+}
+
+void LocalAgentProtocol::EmitJson(const std::string& json) {
+    last_incoming_time_ = std::chrono::steady_clock::now();
+    if (cJSON* root = cJSON_Parse(json.c_str())) {
+        if (on_incoming_json_) on_incoming_json_(root);
+        cJSON_Delete(root);
+    }
+}
+
+void LocalAgentProtocol::RunOnWorker(std::function<void()> job) {
+    auto* heap_job = new std::function<void()>(std::move(job));
+    if (xQueueSend(jobs_, &heap_job, 0) != pdTRUE) {
+        ESP_LOGW(TAG, "Worker busy, dropping job");
+        delete heap_job;
+    }
+}
+
+void LocalAgentProtocol::WorkerTask(void* arg) {
+    auto* self = static_cast<LocalAgentProtocol*>(arg);
+    while (true) {
+        std::function<void()>* job = nullptr;
+        if (xQueueReceive(self->jobs_, &job, portMAX_DELAY) == pdTRUE && job) {
+            (*job)();
+            delete job;
+        }
+    }
+}
+
+#endif  // CONFIG_KIT_LOCAL_AGENT
