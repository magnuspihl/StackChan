+void LocalAgentProtocol::LoadSettings() {
+    // NVS namespace "kit" (written by the web flasher) overrides build defaults.
+    ::Settings nvs("kit", false);
+    settings_.llm = {nvs.GetString("llm_url", CONFIG_KIT_LLM_BASE_URL), nvs.GetString("llm_key", CONFIG_KIT_LLM_KEY),
+                     nvs.GetString("llm_model", CONFIG_KIT_LLM_MODEL)};
+    settings_.tts = {nvs.GetString("tts_url", CONFIG_KIT_TTS_BASE_URL), nvs.GetString("tts_key", CONFIG_KIT_TTS_KEY),
+                     nvs.GetString("tts_model", CONFIG_KIT_TTS_MODEL)};
+    settings_.stt = {nvs.GetString("stt_url", CONFIG_KIT_STT_BASE_URL), nvs.GetString("stt_key", CONFIG_KIT_STT_KEY),
+                     nvs.GetString("stt_model", CONFIG_KIT_STT_MODEL)};
+    settings_.tts_voice = nvs.GetString("tts_voice", CONFIG_KIT_TTS_VOICE);
+    settings_.stt_language = nvs.GetString("stt_lang", CONFIG_KIT_STT_LANGUAGE);
+    settings_.reply_language = nvs.GetString("reply_lang", CONFIG_KIT_REPLY_LANGUAGE);
+    // "prompt" replaces everything (experts only); "persona" just the character.
+    const std::string base = nvs.GetString("prompt", "");
+    settings_.prompt = (base.empty() ? nvs.GetString("persona", kDefaultPersona) + "\n\n" + kRules : base) +
+                       "\n\nLanguage: always reply in " +
+                       settings_.reply_language +
+                       ", whatever language the user speaks, unless they ask you to switch.";
+    std::string language = settings_.reply_language;
+    for (char& c : language) c = static_cast<char>(tolower(static_cast<unsigned char>(c)));
+    danish_lines_ = language.rfind("da", 0) == 0;  // "Danish", "dansk", "da"
+    ESP_LOGI(TAG, "LLM %s (%s), TTS %s (%s), STT %s (%s)", settings_.llm.base_url.c_str(),
+             settings_.llm.model.c_str(), settings_.tts.base_url.c_str(), settings_.tts.model.c_str(),
+             settings_.stt.base_url.c_str(), settings_.stt.model.c_str());
+}
