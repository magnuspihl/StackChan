+#ifndef LOCAL_AGENT_PROTOCOL_H
+#define LOCAL_AGENT_PROTOCOL_H
+
+#include "protocol.h"
+
+#include <freertos/FreeRTOS.h>
+#include <freertos/queue.h>
+#include <freertos/task.h>
+
+#include <atomic>
+#include <condition_variable>
+#include <functional>
+#include <map>
+#include <mutex>
+#include <string>
+#include <vector>
+
+// Plays the voice server's role on the robot itself. Instead of streaming
+// audio to a server, it calls OpenAI-compatible HTTPS APIs directly:
+// speech-to-text, the LLM (with the robot's own MCP tools), then
+// text-to-speech. To the rest of the firmware it looks like any other
+// Protocol: it receives the "listen"/"abort"/"mcp" messages the app sends,
+// and emits the same "stt", "tts", "llm" and "mcp" messages a server would.
+class LocalAgentProtocol : public Protocol {
+public:
+    LocalAgentProtocol();
+    ~LocalAgentProtocol() override;
+
+    bool Start() override;
+    bool OpenAudioChannel() override;
+    void CloseAudioChannel(bool send_goodbye = true) override;
+    bool IsAudioChannelOpened() const override;
+    bool SendAudio(std::unique_ptr<AudioStreamPacket> packet) override;
+    void OnVoiceActivity(bool speaking) override;
+
+protected:
+    // All control messages from the app (listen, abort, mcp, ...) arrive here.
+    bool SendText(const std::string& text) override;
+
+private:
+    struct Endpoint {
+        std::string base_url;
+        std::string key;
+        std::string model;
+    };
+    struct Settings {
+        Endpoint llm;
+        Endpoint tts;
+        Endpoint stt;
+        std::string tts_voice;
+        std::string stt_language;
+        std::string reply_language;
+        std::string prompt;  // includes the reply-language line
+    };
+
+    void LoadSettings();
+    void HandleListen(const std::string& state);
+    void ResumeListening();
+    void FinishUtterance();
+    void ProcessUtterance(std::vector<std::vector<uint8_t>> packets);
+    std::string Transcribe(const std::string& ogg);
+    std::string Chat(const std::string& user_text);
+    std::string PostJson(const Endpoint& endpoint, const char* path, std::string body, int timeout_ms);
+    std::string CallTool(const std::string& name, const std::string& arguments);
+    // Streams the reply's speech; on_first_audio runs once, just before sound starts.
+    void Speak(const std::string& text, const std::function<void()>& on_first_audio);
+    void EmitJson(const std::string& json);
+    // Display status (status light) for states the app doesn't know about.
+    void ShowStatus(const char* status);
+    void RunOnWorker(std::function<void()> job);
+    static void WorkerTask(void* arg);
+
+    // The robot's own MCP server (head, LED, volume, ...), reached through the
+    // app as if we were a remote server. Returns the JSON-RPC "result" or
+    // "error" object, or "" on timeout.
+    std::string McpRequest(const std::string& method, const std::string& params_json, int timeout_ms = 5000);
+    void LoadTools();
+
+    Settings settings_;
+    bool danish_lines_ = false;  // the robot's own fallback lines in Danish
+    std::atomic<bool> channel_open_{false};
+    std::atomic<bool> aborted_{false};
+    std::atomic<bool> sleep_pending_{false};
+    std::string sleep_goodbye_;  // from the go_to_sleep call
+    std::string pending_photo_;  // data: URL from take_photo, sent with the next request
+
+    // Conversation so far as serialized chat messages; worker task only.
+    std::vector<std::string> history_;
+    int64_t last_turn_us_ = 0;
+    // OpenAI "tools" array (JSON) and the function name -> MCP tool name map.
+    std::string tools_json_;
+    std::map<std::string, std::string> tool_names_;
+
+    // Pending MCP requests, answered from SendText on the main task.
+    std::mutex mcp_mutex_;
+    std::condition_variable mcp_cv_;
+    std::map<int, std::string> mcp_replies_;
+    int next_mcp_id_ = 1;
+
+    // Utterance capture, guarded by mutex_.
+    std::mutex mutex_;
+    bool listening_ = false;
+    bool heard_voice_ = false;
+    bool voice_active_ = false;
+    int64_t listen_started_us_ = 0;
+    int64_t voice_ended_us_ = 0;
+    std::vector<std::vector<uint8_t>> packets_;
+
+    QueueHandle_t jobs_ = nullptr;
+    TaskHandle_t worker_ = nullptr;
+};
+
+#endif  // LOCAL_AGENT_PROTOCOL_H
