# Which languages to install: danish, english, or danish,english
COMPOSE_PROFILES=danish

# English models (speaches registry names). If you change them, enter the same
# names in the web flasher's speech settings.
ENGLISH_STT_MODEL=Systran/faster-distil-whisper-large-v3
ENGLISH_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
